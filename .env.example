# ============================================================================
# video-adapter 数据面策略
#
# ⚠️ 这里**没有任何渠道配置** —— 上游地址、凭证、脚本 ref、模型、计费上限
#    全部由调用方按请求头传入（架构 D1）。本文件只放"这台部署怎么跑"。
# ============================================================================

# --- 准入（必填）-----------------------------------------------------------
# 未配置则拒绝所有请求 —— 不是"放行"。
ADAPTER_KEY=

# --- 脚本来源（安全）--------------------------------------------------------
# 本项目**只接受 X-Script-Ref**：降级报告承担语义判断，必须可 review、可追溯。
# 与 image-adapter 相反，这里默认就是关的。打开它等于允许调用方现场投喂翻译逻辑。
ALLOW_INLINE_SCRIPT=false
ALLOW_REMOTE_SCRIPT=false
# 生产保持 true：ref 内容必须与 script_store/manifest.json 的 sha256 一致。
SCRIPT_PIN_MANIFEST_DIGESTS=true
SCRIPT_STORE_DIR=

# --- 出站安全 ---------------------------------------------------------------
# 默认拒绝内网/回环目标（X-Upstream-Url 是调用方可控的出站目标）。
UPSTREAM_ALLOW_PRIVATE_NETWORK=false
# 默认**不信**环境代理：macOS 的 scutil 代理会把回环地址也代理走，
# 表现为拿到网关错误体而不是 connection refused —— 会把本地排障带偏。
UPSTREAM_TRUST_ENV=false

# --- 任务持久化（架构 §6.2）------------------------------------------------
# 🔴 契约要求 GET /tasks/{id} 在 7 天窗口内可用 ⇒ 任务记录必须**跨副本共享、活过重启**。
#   redis   生产（唯一）。**启动即探测**，连不上直接失败（不静默降级、也没有退路）。
#   memory  仅开发的显式开关（启动打 warning，重启即丢 —— 不满足 7 天契约）。
# 🔴 sqlite 后端**已移除**（2026-09-13）：它是单机存储，与"跨副本共享"的语义冲突，
#    而且容器里还要持久卷 + 单 worker + 优雅停机三件套 —— 收敛掉它，部署形态只剩一种。
TASK_STORE=redis
TASK_STORE_URL=redis://redis:6379/0
# 任务记录的 key 前缀。**多个部署共用同一个 redis 时必须区分**，
# 否则彼此的列表会互相看见（限流桶同理，见下面的 RATE_LIMIT_KEY_PREFIX）。
TASK_STORE_KEY_PREFIX=task
TASK_RETENTION_DAYS=7

# 🔴 凭证指纹用的服务端密钥。
#
#   它解决的是这个问题：**异步任务要在几天后被回查，而回查时带哪把钥匙并不确定**。
#   上游要求查询接口带同一把 Key，且上游侧的任务**按钥匙归属**
#   （任务列表只返回当前 Key 名下的任务）。
#
#   所以我们必须在任务记录里记住"这个任务当初是哪把钥匙建的"，但又**不能把钥匙本身存进库**。
#   做法：存指纹 = HMAC-SHA256(本密钥, 调用方的 Key)。
#   查询/取消时重算指纹，**不符就直接 404，根本不发上游请求**。
#
#   为什么是 HMAC 而不是裸 sha256：API Key 是低熵可枚举空间（`ak_` + 短随机段），
#   裸哈希可以被离线爆破（拿到库就能反推候选 Key）；HMAC 还要求攻击者知道本密钥。
#   生成：openssl rand -hex 32
#
#   ⚠️ 运维注意：**轮换本密钥会让所有存量任务读不出**（重算的指纹与记录不符 → 404），
#   最长影响一个任务保留期（TASK_RETENTION_DAYS，默认 7 天）。
#   轮换前请确认可以接受这段时间内旧任务查不到。
#   缺失时退化为裸 sha256，`/healthz` 与启动日志会如实报告算法（不静默）。
TASK_KEY_FINGERPRINT_SECRET=

# --- 并发与超时 -------------------------------------------------------------
# 渠道级上限由 X-Channel-Options.max_concurrency 覆盖；这里是兜底默认。
# 槽位**从创建占到终态**（不是创建返回就释放）。
DEFAULT_MAX_CONCURRENCY=4
QUEUE_WAIT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=60
UPSTREAM_RETRY_ATTEMPTS=3

# --- 上游限流与查询降频（架构 §7.1）-----------------------------------------
# 🔴 上游对**任务查询接口**按 **IP** 限 60 次/分钟（超限 429 + Retry-After）。
#    "按 IP" 意味着配额属于**出口身份**：不属于 Key、不属于 provider、也不属于 worker
#    进程。所以本服务只声明**一部分**额度 —— 同一出口 IP 上还有别的消费者，
#    而我们看不见他们用了多少。
#
#    实现口径是"降频优先于退避"：先用短 TTL 缓存 + 并发合并**真正减少请求数**，
#    再用主动令牌桶兜住速率，最后才是 429 冷却。
RATE_LIMIT_ENABLED=true
# 查询车道每分钟上限。**默认 30 = 上游 60 的一半** —— 不要贴着 60 配。
RATE_LIMIT_QUERY_RPM=30
# 突发额度。刻意取小：上游的窗口实现未知（固定窗口在边界会放行双倍额度），
# 一次放出 60 个请求是"必然踩线"的写法。
RATE_LIMIT_QUERY_BURST=5
# 无令牌时最多排队等这么久（秒），超出即按契约回 429 + `Retry-After`。
RATE_LIMIT_WAIT_SECONDS=3
# 429 冷却封顶（秒）。上游给更大的 `Retry-After` 时按此截断，并**告警**（截断不静默）。
RATE_LIMIT_COOLDOWN_MAX_SECONDS=120
# 429 之后允许原地重试的等待上限（秒）。超过它就不占着连接干等 —— 交给调用方按
# Retry-After 退避（那本来就是 429 的契约语义）。
RATE_LIMIT_RETRY_BUDGET_SECONDS=1
# 🔴 降频主力：同一任务的查询结果在此窗口内直接回放，**一次上游请求都不发**。
#    代价是状态更新最多延迟这么久（分钟级的视频任务完全可接受）。
#    0 = 关闭缓存（只保留并发合并）。
QUERY_CACHE_SECONDS=2
# --- 限流桶放在哪：跨进程共享（架构 §7.1）-----------------------------------
# 上游按 **IP** 限流 ⇒ 配额属于**出口身份** ⇒ 桶必须**跨进程**才是对的。
#   process  进程内桶。单副本正确；多 worker / 多副本时实际配额 ≈ 进程数 × rpm。
#   redis    **共享桶**（Lua 脚本 + **Redis 服务器时钟**，避免多副本本地时钟漂移）；
#            所有进程合起来才是配置的 rpm。
# 留空 = **跟随 TASK_STORE**：多副本部署本来就必须把任务表放到共享存储上（§6.2），
#        这条推断省掉一个要配的旋钮，也少一个"任务表共享了、桶忘了共享"的错配机会。
RATE_LIMIT_STORE=
# redis 地址；留空则回落 TASK_STORE_URL。（`redis` 包已是 requirements.txt 里的**正式依赖**、
# 随镜像提供；早期把它留成注释里的可选项时，CI 与生产的差异只会在**启动期**才暴露。）
RATE_LIMIT_STORE_URL=
# 多个部署共用同一个 redis 时必须区分前缀。否则它们会共享桶：若在同一出口 IP 上，
# 共享恰好是对的；不在同一出口上则过于保守。
RATE_LIMIT_KEY_PREFIX=ratelimit
# 单次 Redis 操作超时（毫秒）。刻意很短：限流不该成为查询延迟的大头。
RATE_LIMIT_REDIS_TIMEOUT_MS=500
# 共享后端不可用时怎么办：
#   open   退回**进程内桶**（仍然限速，只是不再精确）+ 告警 + `/healthz` 标记 degraded
#   closed 拒绝请求（等于把 Redis 变成可用性硬依赖）
# 默认 open 的理由：配额超了是**软**故障（退避即可，上游还有 429 兜底），
# 而把整个服务的查询打死是**硬**故障。
RATE_LIMIT_FAIL_MODE=open
#
# ⚠️ 仍在用 process（或降级到 process）时：多 worker / 多副本下把 rpm 按进程数**整除**
#    （3 副本 × 1 worker、希望整体 ≤30/min ⇒ 每进程配 10）。`/healthz` 的
#    `rate_limit.scope` 会如实告诉你是 `shared` 还是 `process` —— 它不会假装共享。

# --- 素材转存（rehost）------------------------------------------------------
# 开关在**渠道**上（逐渠道）：X-Channel-Options: {"rehost": true}
# 默认关闭 —— 上游产物若是公开且有效期与原生语义一致（aivideomaker 是公开 24h URL），
# 透传即可，多一跳只增加失败面。开启的场景是「产物需鉴权」或「有效期短于调用方预期」。
#
# 存储后端默认是**本地目录 + 由本服务 GET /files/<name> 对外提供**（零依赖、开箱可用）。
# 对象名 = sha256(产物URL)[:24] + 扩展名 ⇒ 同一产物重复转存是幂等的，不会堆副本。
MEDIA_DIR=
# ⚠️ 开了 rehost 就应当设它：不设的话 content.video_url 会是**相对路径**（会如实告警）。
#    例：https://adapter.example.com
PUBLIC_BASE_URL=
# 产物大小上限：超了直接拒绝下载并在 warnings 里说明（防止一个超大文件把内存打满）
REHOST_MAX_BYTES=536870912
REHOST_TIMEOUT_SECONDS=120

# --- 请求体 -----------------------------------------------------------------
BODY_LIMIT_BYTES=67108864

# --- 后台协调器（默认关，架构 §6.5）-----------------------------------------
# 它没有调用方请求可借钥匙，所以只能做"本地能判定"的事（超时置 expired）。
# 开启还意味着服务端要主动出站，需单独过白名单。
RECONCILER_ENABLED=false
RECONCILER_INTERVAL_SECONDS=15

# --- 部署（进程与端口）-----------------------------------------------------
# 容器内监听端口；gunicorn 与镜像的健康检查都读它。
PORT=8000
# gunicorn worker 数。🔴 **默认 1**，唯一理由是**并发闸门是进程内状态** ——
# 多 worker 会让同一渠道的并发上限放大成 N 倍。
# （任务表与限流桶已经在 redis 上，不再受这条约束；sqlite 后端已移除，
#  "多进程抢单文件锁"这个问题也随之消失。）
# 要放大：接受"闸门按进程各自计数"即可。高可用请用**多副本**（见 docker-compose.yml
# 文末），不要靠单容器堆 worker。
WEB_CONCURRENCY=1
# 存活看门狗（秒）：必须 > 排队等待 + 上游超时，否则合法等待中的 worker 会被 SIGKILL。
GUNICORN_TIMEOUT=300
# 优雅关机窗口（秒）：必须 > 在飞的上游调用 + flush_spans()，且 < compose 的
# stop_grace_period（那里给 150s）。
GUNICORN_GRACEFUL_TIMEOUT=120
# 滚动重启：摊平长进程里的慢泄漏；jitter 防止所有 worker 同时退休。
GUNICORN_MAX_REQUESTS=10000
GUNICORN_MAX_REQUESTS_JITTER=1000
GUNICORN_KEEPALIVE=65
GUNICORN_BACKLOG=2048
GUNICORN_LOG_LEVEL=info

# --- 可观测（架构 §12）-----------------------------------------------------
# 未配置 token 则**不外发**：span 照建，只落本地日志与 sink（离线校验走这条）。
# 「已配置」与「真的会外发」在 /healthz 里是两个字段（还有 ready / reason）。
LOG_LEVEL=INFO
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=video-adapter
ENVIRONMENT=
# 本地把 span 打到终端用；生产保持 false（否则每条 span 都进容器日志）。
# ⚠️ 这个开关曾经是**真 bug**（2026-09-16 报告 F9）：`console=True` 让 logfire.configure 抛
#    AttributeError ⇒ 整个可观测**静默降级**（进程照常 healthy，只有 /healthz.logfire.ready 看得见）。
#    根因是 `console=` 只接受 `ConsoleOptions | None`，已修；`tests/test_observability.py`
#    有回归用例钉住"这个开关打开时 ready 仍为 True"。
LOGFIRE_CONSOLE=false
# loguru → logfire 桥的最低级别。**默认 INFO 全收**：loguru 不是本服务的依赖
#（本服务全用 stdlib logging），它是**宿主应用**的门面，那些行没有别的地方可查。
# 嫌吵（或宿主量大）时调 WARNING / ERROR。loguru 不在场时静默跳过，
# 状态如实报在 /healthz.logfire.loguru_bridge（如 off: loguru is not importable …）。
LOGFIRE_LOGURU_LEVEL=INFO
# 🔴 true 会被**拒绝装配**（不是警告）：宽头抓取会把 X-Adapter-Key / Authorization /
#    X-Auth-Emit 指向的那个头（渠道自选名字）一起抓走，固定名字表不可能覆盖它们的并集。
#    要的是"凭证不入上报"，做法是在源头打码（见 adapter/observability.py）。
LOGFIRE_CAPTURE_HEADERS=false

# --- 上报明细 ---------------------------------------------------------------
# 上游 request / response **原文**（含 body）是否上报 —— 排障资产，默认开。
# 凭证在源头打码：已知名字的凭证头、以及**值里含渠道凭证的任意头**（后者不依赖名字表，
# 因为 X-Auth-Emit 允许渠道自选头名）。body 里只有"键名是凭证名"的叶子会被打码。
OBS_REPORT_BODIES=true
# 单个字符串的上报上限（Seedance 的 content[] 里可能有 base64 素材）；
# 超长会截断并**显式标注**截掉多少，不静默丢。
OBS_BODY_MAX_CHARS=20000
