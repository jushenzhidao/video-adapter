# ============================================================================
# video-adapter 数据面策略
#
# ⚠️ 这里**没有任何渠道配置** —— 上游地址、凭证、脚本 ref、模型、计费上限
#    全部由调用方按请求头传入（架构 D1）。本文件只放"这台部署怎么跑"。
# ============================================================================

# --- 准入（必填）-----------------------------------------------------------
# 未配置则拒绝所有请求 —— 不是"放行"。
ADAPTER_KEY=

# --- 脚本来源（安全）--------------------------------------------------------
# 本项目**只接受 X-Script-Ref**：降级报告承担语义判断，必须可 review、可追溯。
# 与 image-adapter 相反，这里默认就是关的。打开它等于允许调用方现场投喂翻译逻辑。
ALLOW_INLINE_SCRIPT=false
ALLOW_REMOTE_SCRIPT=false
# 生产保持 true：ref 内容必须与 script_store/manifest.json 的 sha256 一致。
SCRIPT_PIN_MANIFEST_DIGESTS=true
SCRIPT_STORE_DIR=

# --- 出站安全 ---------------------------------------------------------------
# 默认拒绝内网/回环目标（X-Upstream-Url 是调用方可控的出站目标）。
UPSTREAM_ALLOW_PRIVATE_NETWORK=false
# 默认**不信**环境代理：macOS 的 scutil 代理会把回环地址也代理走，
# 表现为拿到网关错误体而不是 connection refused —— 会把本地排障带偏。
UPSTREAM_TRUST_ENV=false

# --- 任务持久化（架构 §6.2）------------------------------------------------
# 🔴 契约要求 GET /tasks/{id} 在 7 天窗口内可用。
#    memory 只允许单实例开发用（启动会打 warning，重启即丢）。
TASK_STORE=sqlite
TASK_STORE_PATH=.tasks.sqlite3
# 多实例部署用 redis（缺 redis 包时启动直接报错，不静默降级）：
TASK_STORE_URL=
TASK_RETENTION_DAYS=7

# 🔴 凭证指纹用的服务端密钥。
#
#   它解决的是这个问题：**异步任务要在几天后被回查，而回查时带哪把钥匙并不确定**。
#   上游要求查询接口带同一把 Key，且上游侧的任务**按钥匙归属**
#   （任务列表只返回当前 Key 名下的任务）。
#
#   所以我们必须在任务记录里记住"这个任务当初是哪把钥匙建的"，但又**不能把钥匙本身存进库**。
#   做法：存指纹 = HMAC-SHA256(本密钥, 调用方的 Key)。
#   查询/取消时重算指纹，**不符就直接 404，根本不发上游请求**。
#
#   为什么是 HMAC 而不是裸 sha256：API Key 是低熵可枚举空间（`ak_` + 短随机段），
#   裸哈希可以被离线爆破（拿到库就能反推候选 Key）；HMAC 还要求攻击者知道本密钥。
#   生成：openssl rand -hex 32
#
#   ⚠️ 运维注意：**轮换本密钥会让所有存量任务读不出**（重算的指纹与记录不符 → 404），
#   最长影响一个任务保留期（TASK_RETENTION_DAYS，默认 7 天）。
#   轮换前请确认可以接受这段时间内旧任务查不到。
#   缺失时退化为裸 sha256，`/healthz` 与启动日志会如实报告算法（不静默）。
TASK_KEY_FINGERPRINT_SECRET=

# --- 并发与超时 -------------------------------------------------------------
# 渠道级上限由 X-Channel-Options.max_concurrency 覆盖；这里是兜底默认。
# 槽位**从创建占到终态**（不是创建返回就释放）。
DEFAULT_MAX_CONCURRENCY=4
QUEUE_WAIT_SECONDS=20
REQUEST_TIMEOUT_SECONDS=60
UPSTREAM_RETRY_ATTEMPTS=3

# --- 素材转存（rehost）------------------------------------------------------
# 开关在**渠道**上（逐渠道）：X-Channel-Options: {"rehost": true}
# 默认关闭 —— 上游产物若是公开且有效期与原生语义一致（aivideomaker 是公开 24h URL），
# 透传即可，多一跳只增加失败面。开启的场景是「产物需鉴权」或「有效期短于调用方预期」。
#
# 存储后端默认是**本地目录 + 由本服务 GET /files/<name> 对外提供**（零依赖、开箱可用）。
# 对象名 = sha256(产物URL)[:24] + 扩展名 ⇒ 同一产物重复转存是幂等的，不会堆副本。
MEDIA_DIR=
# ⚠️ 开了 rehost 就应当设它：不设的话 content.video_url 会是**相对路径**（会如实告警）。
#    例：https://adapter.example.com
PUBLIC_BASE_URL=
# 产物大小上限：超了直接拒绝下载并在 warnings 里说明（防止一个超大文件把内存打满）
REHOST_MAX_BYTES=536870912
REHOST_TIMEOUT_SECONDS=120

# --- 请求体 -----------------------------------------------------------------
BODY_LIMIT_BYTES=67108864

# --- 后台协调器（默认关，架构 §6.5）-----------------------------------------
# 它没有调用方请求可借钥匙，所以只能做"本地能判定"的事（超时置 expired）。
# 开启还意味着服务端要主动出站，需单独过白名单。
RECONCILER_ENABLED=false
RECONCILER_INTERVAL_SECONDS=15

# --- 部署（进程与端口）-----------------------------------------------------
# 容器内监听端口；gunicorn 与镜像的健康检查都读它。
PORT=8000
# gunicorn worker 数。🔴 **默认 1，且多数情况下就该是 1**：
#   ① 并发闸门是**进程内**状态 —— 多 worker 会让同一渠道的并发上限放大成 N 倍；
#   ② 默认任务后端是 sqlite 单文件，多 worker 会互相抢锁。
# 要放大：先 `TASK_STORE=redis`（共享任务表），并接受闸门按进程各自计数。
# 高可用请用**多副本 + 共享存储**（见 docker-compose.yml 文末），不要靠单容器堆 worker。
WEB_CONCURRENCY=1
# 存活看门狗（秒）：必须 > 排队等待 + 上游超时，否则合法等待中的 worker 会被 SIGKILL。
GUNICORN_TIMEOUT=300
# 优雅关机窗口（秒）：必须 > 在飞的上游调用 + flush_spans()，且 < compose 的
# stop_grace_period（那里给 150s）。
GUNICORN_GRACEFUL_TIMEOUT=120
# 滚动重启：摊平长进程里的慢泄漏；jitter 防止所有 worker 同时退休。
GUNICORN_MAX_REQUESTS=10000
GUNICORN_MAX_REQUESTS_JITTER=1000
GUNICORN_KEEPALIVE=65
GUNICORN_BACKLOG=2048
GUNICORN_LOG_LEVEL=info

# --- 可观测（架构 §12）-----------------------------------------------------
# 未配置 token 则**不外发**：span 照建，只落本地日志与 sink（离线校验走这条）。
# 「已配置」与「真的会外发」在 /healthz 里是两个字段（还有 ready / reason）。
LOG_LEVEL=INFO
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=video-adapter
ENVIRONMENT=
# 本地把 span 打到终端用；生产保持 false（否则每条 span 都进容器日志）。
LOGFIRE_CONSOLE=false
# 🔴 true 会被**拒绝装配**（不是警告）：宽头抓取会把 X-Adapter-Key / Authorization /
#    X-Auth-Emit 指向的那个头（渠道自选名字）一起抓走，固定名字表不可能覆盖它们的并集。
#    要的是"凭证不入上报"，做法是在源头打码（见 adapter/observability.py）。
LOGFIRE_CAPTURE_HEADERS=false

# --- 上报明细 ---------------------------------------------------------------
# 上游 request / response **原文**（含 body）是否上报 —— 排障资产，默认开。
# 凭证在源头打码：已知名字的凭证头、以及**值里含渠道凭证的任意头**（后者不依赖名字表，
# 因为 X-Auth-Emit 允许渠道自选头名）。body 里只有"键名是凭证名"的叶子会被打码。
OBS_REPORT_BODIES=true
# 单个字符串的上报上限（Seedance 的 content[] 里可能有 base64 素材）；
# 超长会截断并**显式标注**截掉多少，不静默丢。
OBS_BODY_MAX_CHARS=20000
